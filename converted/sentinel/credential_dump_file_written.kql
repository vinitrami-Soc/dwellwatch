// LSASS Dump Or AD Database Written To Disk
// Generated from sigma/stage3_credential_theft/credential_dump_file_written.yml by dwellwatch.convert; do not edit.
imFileEvent
| where (TargetFilePath contains "lsass" and TargetFilePath endswith ".dmp") or (TargetFilePath endswith "\\ntds.dit" and (not(TargetFilePath startswith "C:\\Windows\\NTDS\\")))
