// Directory Replication Requested By A User Account
// Generated from sigma/stage3_credential_theft/dcsync_by_non_dc_account.yml by dwellwatch.convert; do not edit.
SecurityEvent
| where (EventID == 4662 and AccessMask =~ "0x100" and (Properties contains "1131f6aa-9c07-11d1-f79f-00c04fc2dcd2" or Properties contains "1131f6ad-9c07-11d1-f79f-00c04fc2dcd2" or Properties contains "89e95b76-444d-4c62-991a-0facbeda640c")) and (not(SubjectUserName endswith "$"))
