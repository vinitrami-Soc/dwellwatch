// Credential Hives Saved Or Copied
// Generated from sigma/stage3_credential_theft/registry_hives_copied.yml by dwellwatch.convert; do not edit.
imProcessCreate
| where ((TargetProcessName endswith "\\reg.exe" or TargetProcessFileOriginalName =~ "reg.exe") and (TargetProcessCommandLine contains " save " or TargetProcessCommandLine contains " export ") and (TargetProcessCommandLine contains "hklm\\sam" or TargetProcessCommandLine contains "hklm\\system" or TargetProcessCommandLine contains "hklm\\security" or TargetProcessCommandLine contains "hkey_local_machine\\sam" or TargetProcessCommandLine contains "hkey_local_machine\\system" or TargetProcessCommandLine contains "hkey_local_machine\\security")) or (TargetProcessCommandLine contains "HarddiskVolumeShadowCopy" and (TargetProcessCommandLine contains "\\config\\SAM" or TargetProcessCommandLine contains "\\config\\SYSTEM" or TargetProcessCommandLine contains "\\config\\SECURITY")) or ((TargetProcessName endswith "\\esentutl.exe" or TargetProcessFileOriginalName =~ "esentutl.exe") and TargetProcessCommandLine contains "/vss" and (TargetProcessCommandLine contains "\\config\\SAM" or TargetProcessCommandLine contains "\\config\\SYSTEM" or TargetProcessCommandLine contains "\\config\\SECURITY"))
