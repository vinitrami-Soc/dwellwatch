// Active Directory Enumerated With AdFind, SharpHound, AD Explorer Or PowerView
// Generated from sigma/stage2_remote_discovery/ad_recon_tool.yml by dwellwatch.convert; do not edit.
imProcessCreate
| where (TargetProcessName endswith "\\AdFind.exe" or TargetProcessFileOriginalName =~ "AdFind.exe") or (TargetProcessName endswith "\\SharpHound.exe" or TargetProcessFileOriginalName =~ "SharpHound.exe") or ((TargetProcessName endswith "\\ADExplorer.exe" or TargetProcessName endswith "\\ADExplorer64.exe") and TargetProcessCommandLine contains "snapshot") or (((TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\pwsh.exe") or (TargetProcessFileOriginalName in~ ("PowerShell.EXE", "pwsh.dll"))) and (TargetProcessCommandLine contains "Get-DomainUser" or TargetProcessCommandLine contains "Get-NetUser" or TargetProcessCommandLine contains "Get-DomainGroupMember" or TargetProcessCommandLine contains "Get-NetGroupMember" or TargetProcessCommandLine contains "Get-DomainComputer" or TargetProcessCommandLine contains "Get-NetComputer" or TargetProcessCommandLine contains "Find-LocalAdminAccess" or TargetProcessCommandLine contains "Invoke-UserHunter" or TargetProcessCommandLine contains "Invoke-ShareFinder"))
