// Domain Trusts Or Controllers Listed
// Generated from sigma/stage2_remote_discovery/domain_trust_discovery.yml by dwellwatch.convert; do not edit.
imProcessCreate
| where ((TargetProcessName endswith "\\nltest.exe" or TargetProcessFileOriginalName =~ "nltestrk.exe") and (TargetProcessCommandLine contains "domain_trusts" or TargetProcessCommandLine contains "all_trusts" or TargetProcessCommandLine contains "trusted_domains" or TargetProcessCommandLine contains "dclist")) or ((TargetProcessName endswith "\\dsquery.exe" or TargetProcessFileOriginalName =~ "dsquery.exe") and TargetProcessCommandLine contains "trustedDomain") or (((TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\pwsh.exe") or (TargetProcessFileOriginalName in~ ("PowerShell.EXE", "pwsh.dll"))) and (TargetProcessCommandLine contains "Get-NetDomainTrust" or TargetProcessCommandLine contains "Get-DomainTrust" or TargetProcessCommandLine contains "Get-NetForestTrust" or TargetProcessCommandLine contains "Get-ForestTrust" or TargetProcessCommandLine contains "Get-ADTrust" or TargetProcessCommandLine contains "GetAllTrustRelationships" or TargetProcessCommandLine contains "Get-DomainController" or TargetProcessCommandLine contains "Get-NetDomainController"))
