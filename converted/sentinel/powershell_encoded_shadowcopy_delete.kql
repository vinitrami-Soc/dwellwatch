// Shadow Copies Deleted With Encoded PowerShell
// Generated from sigma/stage5_backup_destruction/powershell_encoded_shadowcopy_delete.yml by dwellwatch.convert; do not edit.
imProcessCreate
| where ((TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\pwsh.exe") or (TargetProcessFileOriginalName in~ ("PowerShell.EXE", "pwsh.dll"))) and (TargetProcessCommandLine contains "VwBpAG4AMwAyAF8AUwBoAGEAZABvAHcAYwBvAHAAeQ" or TargetProcessCommandLine contains "cAaQBuADMAMgBfAFMAaABhAGQAbwB3AGMAbwBwAHkA" or TargetProcessCommandLine contains "XAGkAbgAzADIAXwBTAGgAYQBkAG8AdwBjAG8AcAB5A" or TargetProcessCommandLine contains "VwBpAG4AMwAyAF8AUwBoAGEAZABvAHcAQwBvAHAAeQ" or TargetProcessCommandLine contains "cAaQBuADMAMgBfAFMAaABhAGQAbwB3AEMAbwBwAHkA" or TargetProcessCommandLine contains "XAGkAbgAzADIAXwBTAGgAYQBkAG8AdwBDAG8AcAB5A" or TargetProcessCommandLine contains "dwBpAG4AMwAyAF8AcwBoAGEAZABvAHcAYwBvAHAAeQ" or TargetProcessCommandLine contains "cAaQBuADMAMgBfAHMAaABhAGQAbwB3AGMAbwBwAHkA" or TargetProcessCommandLine contains "3AGkAbgAzADIAXwBzAGgAYQBkAG8AdwBjAG8AcAB5A") and (TargetProcessCommandLine contains "LgBEAGUAbABlAHQAZQAoA" or TargetProcessCommandLine contains "4ARABlAGwAZQB0AGUAKA" or TargetProcessCommandLine contains "uAEQAZQBsAGUAdABlACgA" or TargetProcessCommandLine contains "LgBkAGUAbABlAHQAZQAoA" or TargetProcessCommandLine contains "4AZABlAGwAZQB0AGUAKA" or TargetProcessCommandLine contains "uAGQAZQBsAGUAdABlACgA" or TargetProcessCommandLine contains "UgBlAG0AbwB2AGUALQBXAG0AaQBPAGIAagBlAGMAdA" or TargetProcessCommandLine contains "IAZQBtAG8AdgBlAC0AVwBtAGkATwBiAGoAZQBjAHQA" or TargetProcessCommandLine contains "SAGUAbQBvAHYAZQAtAFcAbQBpAE8AYgBqAGUAYwB0A" or TargetProcessCommandLine contains "UgBlAG0AbwB2AGUALQBDAGkAbQBJAG4AcwB0AGEAbgBjAGUA" or TargetProcessCommandLine contains "IAZQBtAG8AdgBlAC0AQwBpAG0ASQBuAHMAdABhAG4AYwBlA" or TargetProcessCommandLine contains "SAGUAbQBvAHYAZQAtAEMAaQBtAEkAbgBzAHQAYQBuAGMAZQ")
