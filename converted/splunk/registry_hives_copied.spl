(Image="*\\reg.exe" OR OriginalFileName="reg.exe" CommandLine IN ("* save *", "* export *") CommandLine IN ("*hklm\\sam*", "*hklm\\system*", "*hklm\\security*", "*hkey_local_machine\\sam*", "*hkey_local_machine\\system*", "*hkey_local_machine\\security*")) OR (CommandLine="*HarddiskVolumeShadowCopy*" CommandLine IN ("*\\config\\SAM*", "*\\config\\SYSTEM*", "*\\config\\SECURITY*")) OR (Image="*\\esentutl.exe" OR OriginalFileName="esentutl.exe" CommandLine="*/vss*" CommandLine IN ("*\\config\\SAM*", "*\\config\\SYSTEM*", "*\\config\\SECURITY*"))
