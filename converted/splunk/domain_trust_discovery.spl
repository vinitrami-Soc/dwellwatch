(Image="*\\nltest.exe" OR OriginalFileName="nltestrk.exe" CommandLine IN ("*domain_trusts*", "*all_trusts*", "*trusted_domains*", "*dclist*")) OR (Image="*\\dsquery.exe" OR OriginalFileName="dsquery.exe" CommandLine="*trustedDomain*") OR (Image IN ("*\\powershell.exe", "*\\pwsh.exe") OR OriginalFileName IN ("PowerShell.EXE", "pwsh.dll") CommandLine IN ("*Get-NetDomainTrust*", "*Get-DomainTrust*", "*Get-NetForestTrust*", "*Get-ForestTrust*", "*Get-ADTrust*", "*GetAllTrustRelationships*", "*Get-DomainController*", "*Get-NetDomainController*"))
